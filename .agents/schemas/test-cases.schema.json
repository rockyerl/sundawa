{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sundawa QA Test Case Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "generated_at",
    "source_requirements",
    "cases",
    "coverage_notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_ids",
          "category",
          "priority",
          "preconditions",
          "steps",
          "expected",
          "automation_candidate",
          "execution_status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "category": {
            "enum": [
              "positive",
              "negative",
              "boundary",
              "state-transition",
              "decision-table",
              "security",
              "accessibility",
              "performance",
              "recovery",
              "exploratory"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "automation_candidate": {
            "type": "boolean"
          },
          "execution_status": {
            "enum": [
              "not-run",
              "pass",
              "fail",
              "blocked"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "coverage_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sundawa Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "project",
    "reviewed_at",
    "overall",
    "gates",
    "blocking_findings",
    "limitations",
    "approver"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "enum": [
        "prototype",
        "web",
        "api",
        "enterprise",
        "regulated"
      ]
    },
    "project": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall": {
      "enum": [
        "PASS",
        "REVIEW",
        "BLOCK"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence_ids",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not-tested",
              "not-applicable",
              "waived"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approver": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sundawa.net/schemas/risk-register.schema.json",
  "title": "Risk Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "as_of",
    "evidence_catalog",
    "risk_appetite",
    "risks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "evidence_catalog": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uri",
          "summary",
          "captured_at",
          "verified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 5
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified": {
            "type": "boolean"
          },
          "verified_by": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "internal",
              "restricted",
              "public"
            ]
          }
        }
      }
    },
    "risk_appetite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "high_threshold",
        "accepted_by_role",
        "approved_reference"
      ],
      "properties": {
        "high_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "accepted_by_role": {
          "type": "string",
          "minLength": 1
        },
        "approved_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "risk_owner",
          "likelihood",
          "impact",
          "status",
          "planned_treatment",
          "due_date",
          "evidence_ids",
          "cobit2019_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 6
          },
          "category": {
            "enum": [
              "security",
              "delivery",
              "quality",
              "operational",
              "legal",
              "privacy",
              "vendor",
              "data",
              "ai",
              "other"
            ]
          },
          "risk_owner": {
            "type": "string",
            "minLength": 1
          },
          "likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "status": {
            "enum": [
              "open",
              "in-treatment",
              "mitigated",
              "accepted",
              "closed"
            ]
          },
          "planned_treatment": {
            "type": "string",
            "minLength": 8
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cobit2019_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approved_by",
              "role",
              "approved_at",
              "expires_at",
              "reason",
              "reference"
            ],
            "properties": {
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "minLength": 10
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "residual_likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "residual_impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "closure_verified_by": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

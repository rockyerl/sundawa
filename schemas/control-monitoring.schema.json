{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sundawa.net/schemas/control-monitoring.schema.json",
  "title": "Control Monitoring",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "as_of",
    "evidence_catalog",
    "controls",
    "monitoring_scope",
    "scope_approved_by",
    "scope_approval_reference"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "evidence_catalog": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "uri",
          "summary",
          "captured_at",
          "verified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 5
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified": {
            "type": "boolean"
          },
          "verified_by": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "classification": {
            "enum": [
              "internal",
              "restricted",
              "public"
            ]
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "description",
          "owner",
          "cobit2019_ids",
          "critical",
          "applicable",
          "cadence",
          "last_checked",
          "next_due",
          "status",
          "evidence_ids",
          "verification_method"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "cobit2019_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "critical": {
            "type": "boolean"
          },
          "applicable": {
            "type": "boolean"
          },
          "cadence": {
            "enum": [
              "per-release",
              "daily",
              "weekly",
              "monthly",
              "quarterly",
              "annual"
            ]
          },
          "last_checked": {
            "type": "string",
            "format": "date"
          },
          "next_due": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "enum": [
              "effective",
              "ineffective",
              "not-tested",
              "not-applicable"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 0,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "corrective_action_id": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "monitoring_scope": {
      "type": "string",
      "minLength": 8
    },
    "scope_approved_by": {
      "type": "string",
      "minLength": 1
    },
    "scope_approval_reference": {
      "type": "string",
      "minLength": 1
    }
  }
}
